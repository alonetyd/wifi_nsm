# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.1 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# =============================================================================
# PSRAM 内存优化配置 - ESP32-P4 Octal/Hex PSRAM
# =============================================================================
# 启用 PSRAM (Octal SPIRAM @ 200MHz)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_SPIRAM_MODE_HEX is not set
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_SPEED=200
# PSRAM 作为可执行内存 (XIP), 加速代码执行
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set
# PSRAM ECC 关闭 (默认, 提升性能)
# CONFIG_SPIRAM_ECC_ENABLE is not set
# 硬件初始化 (推荐, 由 bootloader 完成)
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
# PSRAM 内存保护配置
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
# 忽略 PSRAM 未找到警告 (兼容无 PSRAM 硬件)
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
# 不使用 memory-mapped 模式 (使用 malloc 模式更灵活)
# CONFIG_SPIRAM_USE_MEMMAP is not set
# 使用 malloc 模式 (推荐, 通过 heap_caps 分配)
CONFIG_SPIRAM_USE_MALLOC=y
# 启动时执行 PSRAM 内存测试
CONFIG_SPIRAM_MEMTEST=y

# PSRAM 分配策略优化
# 内部 RAM 最小分配阈值: 超过此大小的分配优先使用 PSRAM
# 降低到 8KB 让更多中型缓冲区使用 PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192
# 保留 16KB 内部 RAM 给 DMA 和中断使用
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
# 允许外部 BSS 段使用 PSRAM (省内部 RAM)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# 允许 noinit 段使用 PSRAM
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y

# 任务栈使用 PSRAM (大幅节省内部 RAM)
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# LVGL 渲染优化: P4 双核并行渲染 + 样式缓存
# 说明: LVGL 9.3.0 的 LV_USE_DRAW_DMA2D 是 STM32 专用, 本工程并无
# LV_USE_ESP32_P4_GPU 宏; P4 当前可用的加速 = 多核并行软件渲染.
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_OBJ_STYLE_CACHE=y

# ESP-Hosted: SDIO interface with ESP32 co-processor
# 从机为原始 ESP32; 必须显式选 SLAVE_IDF_TARGET_ESP32, 否则 esp_wifi_remote
# 在 P4 上默认把从机目标强制为 ESP32-C6, 导致 chip mismatch 连不上
CONFIG_SLAVE_IDF_TARGET_ESP32=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32"
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
#CONFIG_ESP_HOSTED_SDIO_SLOT=1
#CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
#CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=28
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=31
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=27
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=26
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=30
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=29
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=32
CONFIG_ESP_HOSTED_HOST_RESET_ACTIVE_LOW=y
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_ESP_HOSTED_HOST_FEAT_BT_AUTO_INIT=n
CONFIG_ESP_HOSTED_HOST_FEAT_BT_AUTO_CONTROLLER_INIT=n
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=n
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_AUTO_INIT=n
CONFIG_ESP_HOSTED_HOST_CP_BRINGUP_TIMEOUT_MS=2000
CONFIG_ESP_HOSTED_HOST_TRANSPORT_RESTART_ON_FAILURE=n

# Bluetooth on ESP32 co-processor via ESP-Hosted
# CP side: 必须启用这些配置让 ESP32 协处理器初始化 BT controller
CONFIG_ESP_HOSTED_CP_FEAT_BT=y
CONFIG_ESP_HOSTED_CP_BT_ENABLED=y
CONFIG_ESP_HOSTED_CP_FEAT_BT_HCI_VHCI=y

# Bluetooth: Bluedroid + Classic BT + A2DP + BLE 4.2
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_AVRCP_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
# ESP32 CP 物理层只支持 BLE 4.2; 若开 BLE 5.0 会触发 eh_host_port_bt.h 的 #error
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set

# Bluedroid 任务栈调大(默认 3KB 太小，A2DP连接时 stack overflow)
CONFIG_BT_BTC_TASK_STACK_SIZE=12288
CONFIG_BT_BTU_TASK_STACK_SIZE=8192

# 把 Bluedroid 内部缓冲分配到 PSRAM, 减小内部 RAM 压力
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y

# AVRCP cover art 不要走 SDP-LARGE, 关闭以省栈/内存
# CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED is not set

# ESP-Hosted HCI 接收 scratch buffer 也放到 PSRAM
CONFIG_ESP_HOSTED_HCI_BLUEDROID_RX_SCRATCH_SIZE=2048

# micro-mp3 (OpenCore-based MP3 decoder) — 优先 PSRAM
CONFIG_MICRO_MP3_PREFER_PSRAM=y

# FAT 文件系统: API 编码改为 UTF-8, 让中文文件名 (LFN) 直接以 UTF-8 形式
# 经 opendir()/readdir() 返回到 LVGL. (默认是 ANSI/OEM, 在 CP437 下中文会乱码)
# 应用层 (ui_file_manager.c) 会再做一次 UTF-8 合法性校验 + GBK 兑底转换.
CONFIG_FATFS_API_ENCODING_UTF_8=y
# CONFIG_FATFS_API_ENCODING_ANSI_OEM is not set
# CONFIG_FATFS_CODEPAGE_DYNAMIC is not set
CONFIG_FATFS_CODEPAGE_437=y

# ESP-Hosted: SDIO 收发 DMA 缓冲优先放 PSRAM (需要 bsp_memory 的 PSRAM-DMA 堆分区)
CONFIG_EH_HOST_PORT_DMA_PREFER_SPIRAM=y
