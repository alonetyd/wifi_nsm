# ESP32 Coprocessor Firmware - BT Controller Only
# This firmware runs on ESP32 and provides BT HCI over SDIO to the ESP32-P4 host

CONFIG_IDF_TARGET="esp32"
CONFIG_IDF_TARGET_ESP32=y

# ESP-Hosted Coprocessor configuration
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

# Disable Wi-Fi - this is BT-only firmware
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# Enable BT Controller
CONFIG_ESP_HOSTED_CP_FEAT_BT=y
CONFIG_ESP_HOSTED_CP_BT_ENABLED=y
CONFIG_ESP_HOSTED_CP_FEAT_BT_HCI_VHCI=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y

# Disable Wi-Fi on ESP32 side
CONFIG_ESP_WIFI_SUPPORT=n

# Storage
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_eh_cp_ota_4m.csv"

# OS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=y
